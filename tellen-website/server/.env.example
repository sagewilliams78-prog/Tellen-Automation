# Copy this file to .env and fill in real values before a production launch.
# Nothing in this file is a secret by itself — it's just documentation of
# what the server expects. Never commit a real .env file.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- n8n chat webhook (the "Try Tellen AI" widget) ---
# Leave N8N_CHAT_WEBHOOK_URL blank to run the chat API in MOCK mode (canned
# demo replies, no external calls).
#
# This connects to the "Customer Chat" trigger in the "AI Receptionist
# (Multi-Client)" n8n workflow (sagesworld.app.n8n.cloud) — the same
# multi-tenant workflow used for real client receptionists. That trigger
# is public (no auth) and picks which business answers from the
# N8N_CLIENT_ID below, which must match an active row in that workflow's
# "clients" data table. A "tellen-automation" row already exists there.
N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/your-webhook-id/chat
N8N_CHAT_API_KEY=
N8N_CLIENT_ID=tellen-automation
N8N_TIMEOUT_MS=15000

# --- Consultation / lead destination ---
# Leave both blank to run lead capture in MOCK mode: submissions are
# validated, rate-limited, and stored locally in server/data/leads.jsonl,
# but NOT emailed or pushed to a CRM anywhere.
# LEAD_DESTINATION_EMAIL is informational today (no SMTP integration is
# wired up yet); LEAD_WEBHOOK_URL, if set, receives a POST of each
# validated lead as JSON.
LEAD_DESTINATION_EMAIL=
LEAD_WEBHOOK_URL=
# Shared secret the n8n webhook checks for (sent as X-Tellen-Secret). Must
# match the literal value in that webhook's onlyRunIf expression in n8n.
LEAD_WEBHOOK_SECRET=

# --- CORS ---
# Comma-separated list of origins allowed to call the API cross-origin.
# Leave blank for local/dev, where this same server also serves the
# frontend (same-origin, no CORS needed). Set this only if you ever host
# the static site separately from this API server.
# Example: ALLOWED_ORIGINS=https://www.tellenautomation.com
ALLOWED_ORIGINS=

# --- Rate limits ---
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=20
CONSULTATION_RATE_LIMIT_WINDOW_MS=900000
CONSULTATION_RATE_LIMIT_MAX=5

# --- Testing ---
# Force mock mode even if the above are set (useful for demos/tests
# without risking a real send). 1/true or 0/false.
FORCE_MOCK_MODE=0
